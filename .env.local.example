# Anthropic (used by /api/match and the daily digest cron)
ANTHROPIC_API_KEY=

# Neon Postgres (Drizzle ORM)
DATABASE_URL=

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe (added in SaaS Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# Optional: explicit base URL for Stripe redirects + email links. On Vercel
# the deploy URL is auto-detected, so this is only needed for non-Vercel
# environments or to pin a custom domain.
# NEXT_PUBLIC_APP_URL=https://job-cannon.vercel.app

# Resend (added in SaaS Phase 4)
RESEND_API_KEY=

# Vercel Cron auth (added in SaaS Phase 4)
CRON_SECRET=
