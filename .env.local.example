# Anthropic (used by /api/match and the daily digest cron)
ANTHROPIC_API_KEY=

# Neon Postgres (Drizzle ORM)
DATABASE_URL=

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe (added in SaaS Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# Explicit base URL for Stripe redirects + email links. REQUIRED in
# production once a custom domain is in use (Vercel's auto-detected
# VERCEL_PROJECT_PRODUCTION_URL is the .vercel.app URL, not your domain).
# NEXT_PUBLIC_APP_URL=https://jobcannon.app

# Resend (added in SaaS Phase 4)
RESEND_API_KEY=

# Vercel Cron auth (added in SaaS Phase 4)
CRON_SECRET=
